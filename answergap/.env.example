# ── AnswerGap ────────────────────────────────────────────────────────────────
# The free scan — the entire core product — runs with NO keys set.
# Everything below is optional and only unlocks payments.

# Public URL of the deployment. Used to build Stripe redirect URLs.
# On Vercel this is inferred automatically; set it for a custom domain.
NEXT_PUBLIC_APP_URL=

# Stripe secret key. Without it, the Fix Pack checkout returns a clear
# "not configured" message and the free scan is unaffected.
#   sk_test_...  → test mode, no real money moves
#   sk_live_...  → live mode, real charges
STRIPE_SECRET_KEY=

# Fix Pack price, in the smallest currency unit. Defaults to 2900 ($29).
FIX_PACK_PRICE_CENTS=
FIX_PACK_CURRENCY=

# Set to any random string to preview a Fix Pack without paying:
#   /report/<domain>?preview=<PREVIEW_TOKEN>
# Leave unset in production to disable the bypass entirely.
PREVIEW_TOKEN=
