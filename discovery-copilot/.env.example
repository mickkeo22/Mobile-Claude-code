# ── Discovery Copilot configuration ──────────────────────────────
# Copy this file to .env and fill in the two API keys.
# The app refuses to start without both keys.

# Deepgram — https://console.deepgram.com  (streaming speech-to-text)
DEEPGRAM_API_KEY=

# Anthropic — https://console.anthropic.com  (live suggestions + reports)
ANTHROPIC_API_KEY=

# ── Optional overrides (sensible defaults built in) ───────────────
# Deepgram model for streaming + prerecorded transcription.
#DEEPGRAM_MODEL=nova-3

# Anthropic model for the live suggestion engine (fast + cheap, called often).
#LIVE_MODEL=claude-haiku-4-5

# Anthropic model for report generation (called once per session).
#REPORT_MODEL=claude-sonnet-4-6

# Port the local server listens on.
#DC_PORT=8710
