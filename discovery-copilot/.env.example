# ── Discovery Copilot configuration ──────────────────────────────
# Copy this file to .env. The app refuses to start (with a clear
# message) if the pieces required by your chosen mode are missing.

# Deepgram — https://console.deepgram.com  (streaming speech-to-text)
# ALWAYS required: there's no subscription substitute for transcription.
# Costs well under a cent per minute.
DEEPGRAM_API_KEY=

# ── Intelligence backend ──────────────────────────────────────────
# claude_code (default): runs on your Claude Pro/Max subscription via
#   Claude Code — no ANTHROPIC_API_KEY needed. Requirements:
#     1. Claude Code installed (https://claude.com/claude-code)
#     2. logged in with your subscription:  claude login
#   Best on Max plans. On Pro, also set LIVE_MIN_INTERVAL_SECS=45.
# api: metered Anthropic API — lowest latency, needs the key below.
LLM_BACKEND=claude_code

# Anthropic API key — ONLY needed when LLM_BACKEND=api
# (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Optional overrides (sensible defaults built in) ───────────────
# Deepgram model for streaming + prerecorded transcription.
#DEEPGRAM_MODEL=nova-3

# Model for the live suggestion engine (fast + cheap, called often).
#LIVE_MODEL=claude-haiku-4-5

# Model for report generation (called once per session).
#REPORT_MODEL=claude-sonnet-4-6

# Minimum seconds between live-suggestion calls (default 20).
# On a Claude Pro subscription, raise to ~45–60 to protect the usage window.
#LIVE_MIN_INTERVAL_SECS=20

# Port the local server listens on.
#DC_PORT=8710
