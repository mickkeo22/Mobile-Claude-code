# ── Required in production ────────────────────────────────────────────────
# Server-side Anthropic key (already set on the live Vercel project)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — durable lead storage. Server-only; never exposed to the browser.
# URL:   Supabase dashboard → Project Settings → API → Project URL
# Key:   Project Settings → API keys → service_role (secret) key
SUPABASE_URL=https://uxcxfhnthgidhxhhtanh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin command center password (single operator). Pick something long.
ADMIN_PASSWORD=

# Secret for cron endpoints (Vercel sends it automatically as a Bearer token
# once set in project env). Any long random string.
CRON_SECRET=

# ── Strongly recommended ──────────────────────────────────────────────────
# GHL inbound-webhook URL (Automation → Workflows → Inbound Webhook trigger).
# When unset, leads are still stored durably and the admin shows a warning —
# the push is queued and retried once you set this.
GHL_WEBHOOK_URL=

# Resend (https://resend.com) — powers the morning digest email AND the
# lead-facing audit report email. Free tier is plenty. When unset, both are
# skipped gracefully.
RESEND_API_KEY=
# Where the morning digest goes.
DIGEST_EMAIL_TO=keoughmick768@gmail.com
# Optional "from" for the digest (defaults to onboarding@resend.dev which
# works with no domain setup; switch after verifying the domain).
DIGEST_EMAIL_FROM=
# Sender for the audit report emailed to LEADS. Requires mkoperating.com to
# be verified in Resend (Domains -> Add Domain -> two DNS records) — the
# resend.dev test sender can only deliver to your own inbox. Until this is
# set, leads still see their report on-page and at /r/<id>; no email is sent.
# Example: MK Operating <audit@mkoperating.com>
AUDIT_EMAIL_FROM=

# ── Optional ──────────────────────────────────────────────────────────────
# Shared secret for the GHL "booking created" webhook back into the app
# (marks leads as booked automatically). Any long random string; the GHL
# workflow must send it as ?token=... on the webhook URL.
GHL_BOOKING_TOKEN=

# Model override (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=

# Absolute site URL, used in emails/links (defaults to https://mkoperating.com)
NEXT_PUBLIC_SITE_URL=

# Session-signing secret; derived from ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Dev only: set to 1 to serve canned AI responses with no ANTHROPIC_API_KEY.
# Never set in production.
DEMO_MODE=
