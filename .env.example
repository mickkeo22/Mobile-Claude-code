# ─────────────────────────────────────────────────────────────────────────────
# Aether — environment configuration
# Copy to `.env.local` and fill in. Nothing here is required to BUILD the app,
# but the matching feature stays in "demo mode" until its keys are present.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aether

# ── Supabase (auth + database) ───────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for webhooks + admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (the AI brain: support agent, lead scoring, content) ────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for client-facing work.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Stripe (billing) ─────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for each plan (create in the Stripe dashboard, then paste).
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=
NEXT_PUBLIC_STRIPE_PRICE_SCALE=

# ── Outbound messaging (lead follow-up) ──────────────────────────────────────
# Email — Resend (https://resend.com). Optional; falls back to logged drafts.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aether <hello@youragency.com>"
# SMS — Twilio. Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Internal automation auth ─────────────────────────────────────────────────
# A random secret protecting cron/automation endpoints. `openssl rand -hex 32`
CRON_SECRET=
